# =============================================================================
# AI Research Paper Critic - example configuration
# =============================================================================
# Copy this file to ".env" and fill in your own credentials:
#     Windows:     copy .env.example .env
#     macOS/Linux: cp .env.example .env
#
# Only two credentials are required: TYPESAFE_API_KEY (routing) and
# OPENAI_API_KEY (embeddings, vision, analysis, critique).
# Every value in this file is public-safe; never commit a real .env.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Credentials (secrets - leave empty here, fill in your own values)
# -----------------------------------------------------------------------------

# TypeSafe API key: used by the JEV router, and by the vision/analysis/critique
# clients when their provider is set to "typesafe".
TYPESAFE_API_KEY=

# OpenAI API key: used for embeddings, and as the fallback credential for the
# vision, analysis and critique clients when their provider is set to "openai".
OPENAI_API_KEY=

# Optional per-stage credentials. Each stage prefers its own variable and falls
# back to the provider key above when it is empty:
#     provider "openai"   -> <STAGE>_API_KEY, then OPENAI_API_KEY
#     provider "typesafe" -> <STAGE>_API_KEY, then TYPESAFE_API_KEY
# Leave these empty unless you want a separate credential per stage.
VISION_API_KEY=
ANALYSIS_API_KEY=
CRITIQUE_API_KEY=


# -----------------------------------------------------------------------------
# 2. JEV Router - routing decisions only (never used for generation)
# -----------------------------------------------------------------------------

# Routing model id.
TYPESAFE_JEV_MODEL=jev-latest

# System One API endpoint (this default is used when the variable is empty).
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Routing confidence thresholds above which retrieval / visual analysis is enabled.
JEV_RAG_ENABLE_THRESHOLD=0.70
JEV_VISION_ENABLE_THRESHOLD=0.70

# Routing request timeout in seconds.
TYPESAFE_REQUEST_TIMEOUT=30.0


# -----------------------------------------------------------------------------
# 3. RAG Agent - textual evidence retrieval
# -----------------------------------------------------------------------------

# Embedding model used to index and retrieve passages.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Number of texts sent per embedding request.
RAG_EMBEDDING_BATCH_SIZE=64


# -----------------------------------------------------------------------------
# 4. Chunking
# -----------------------------------------------------------------------------

# Word-based chunking; chunks are never split mid-word.
RAG_CHUNK_SIZE_WORDS=600
RAG_CHUNK_OVERLAP_WORDS=100

# Minimum words for a chunk to be kept.
RAG_MIN_CHUNK_WORDS=50


# -----------------------------------------------------------------------------
# 5. Vision Agent - multimodal figure / table analysis
# -----------------------------------------------------------------------------

# Provider: "openai" or "typesafe".
VISION_PROVIDER=openai

# Optional OpenAI-compatible endpoint override (gateway / proxy / self-hosted).
VISION_BASE_URL=

# JEV vision capability level -> multimodal model.
VISION_MODEL_BASIC=gpt-4o-mini
VISION_MODEL_MEDIUM=gpt-4o-mini
VISION_MODEL_ADVANCED=gpt-4o-mini

# Never silently downgrade a capability level unless explicitly enabled.
VISION_ALLOW_LEVEL_FALLBACK=false

# Image extraction and preprocessing.
VISION_RENDER_DPI=200
VISION_MAX_IMAGE_DIMENSION=1600
VISION_IMAGE_FORMAT=PNG
VISION_JPEG_QUALITY=90
VISION_BBOX_PADDING_PTS=4

# Asset limits and context budget.
VISION_MAX_ASSETS=24
VISION_INCLUDE_CANDIDATE_ASSETS=false
VISION_CONTEXT_MAX_CHARS=700

# Where extracted assets are written (built-in default when empty).
VISION_ASSET_OUTPUT_DIR=

# Model call limits.
VISION_MAX_OUTPUT_TOKENS=1200
VISION_REQUEST_TIMEOUT=120


# -----------------------------------------------------------------------------
# 6. Analysis Agent - structured, evidence-grounded research analysis
# -----------------------------------------------------------------------------

# Provider: "openai" or "typesafe".
ANALYSIS_PROVIDER=openai

# Optional OpenAI-compatible endpoint override.
ANALYSIS_BASE_URL=

# JEV analysis capability level -> analysis model.
ANALYSIS_MODEL_BASIC=gpt-4.1-mini
ANALYSIS_MODEL_MEDIUM=gpt-4.1-mini
ANALYSIS_MODEL_ADVANCED=gpt-4.1-mini

# Never silently downgrade a capability level unless explicitly enabled.
ANALYSIS_ALLOW_LEVEL_FALLBACK=false

# Ask the provider for JSON-object mode. Off by default: the contract already
# requires one JSON object as text, so this is only needed for providers that
# behave better with it enabled.
ANALYSIS_JSON_RESPONSE_FORMAT=false

# Evidence context budgets (document structure).
ANALYSIS_MAX_SECTIONS=40
ANALYSIS_MAX_SECTION_TITLE_CHARS=160
ANALYSIS_MAX_INVENTORY_ITEMS=20
ANALYSIS_MAX_CAPTION_CHARS=400
ANALYSIS_MAX_EQUATIONS=12
ANALYSIS_MAX_EQUATION_CHARS=240

# Evidence context budgets (upstream evidence).
ANALYSIS_MAX_RAG_CHUNKS=12
ANALYSIS_MAX_CHUNK_CHARS=1800
ANALYSIS_MAX_VISUAL_ASSETS=12
ANALYSIS_MAX_ASSET_FIELD_CHARS=600
ANALYSIS_MAX_CONTEXT_CHARS=32000

# Model call limits.
ANALYSIS_MAX_OUTPUT_TOKENS=16000
ANALYSIS_REQUEST_TIMEOUT=180


# -----------------------------------------------------------------------------
# 7. Critique Engine - final grounded synthesis
# -----------------------------------------------------------------------------

# Provider: "openai" or "typesafe".
CRITIQUE_PROVIDER=openai

# Optional OpenAI-compatible endpoint override.
CRITIQUE_BASE_URL=

# The critique model follows the JEV analysis level chosen upstream, so this
# per-level mapping mirrors the analysis mapping.
CRITIQUE_MODEL_BASIC=gpt-4.1-mini
CRITIQUE_MODEL_MEDIUM=gpt-4.1-mini
CRITIQUE_MODEL_ADVANCED=gpt-4.1-mini

# Optional single synthesis model used for every level; leave empty to use the
# per-level mapping above.
CRITIQUE_MODEL=

# Never silently downgrade a capability level unless explicitly enabled.
CRITIQUE_ALLOW_LEVEL_FALLBACK=false

# Require every analysis-supported section to be produced. A supported section
# that is missing fails validation; set to false only to downgrade that to a
# warning.
CRITIQUE_REQUIRE_SUPPORTED_SECTIONS=true

# Ask the provider for JSON-object mode (see ANALYSIS_JSON_RESPONSE_FORMAT).
CRITIQUE_JSON_RESPONSE_FORMAT=false

# Synthesis context budgets (upstream evidence).
CRITIQUE_MAX_RAG_CHUNKS=8
CRITIQUE_MAX_CHUNK_CHARS=900
CRITIQUE_MAX_VISUAL_ASSETS=8
CRITIQUE_MAX_ASSET_FIELD_CHARS=400
CRITIQUE_MAX_CONTEXT_CHARS=60000

# Synthesis content budgets.
CRITIQUE_MAX_FINDINGS_PER_DIMENSION=6
CRITIQUE_MAX_STATEMENT_CHARS=700
CRITIQUE_MAX_DIMENSIONS=12
CRITIQUE_MAX_CLAIMS=12
CRITIQUE_MAX_GAPS=15
CRITIQUE_MAX_OPEN_QUESTIONS=10
CRITIQUE_MAX_SECTIONS=25
CRITIQUE_MAX_SECTION_CONTENT_CHARS=4000

# Model call limits.
CRITIQUE_MAX_OUTPUT_TOKENS=16000
CRITIQUE_REQUEST_TIMEOUT=120